    "test": "vitest run",
    "build:prod": "npm run sync:demo && VITE_APPCHECK_DEBUG=false vite build"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
