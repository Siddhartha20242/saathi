{
  "name": "saathi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:demo": "mkdir -p public/demo-bridge && cp extension/content.js public/demo-bridge/content.js",
    "predev": "npm run sync:demo",
    "dev": "vite",
    "build": "npm run sync:demo && vite build",
