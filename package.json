  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "axe-core": "^4.10.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
