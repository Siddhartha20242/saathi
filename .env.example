# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Production: reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local dev only: set to true, copy the debug token printed in the console,
# register it in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG=true
