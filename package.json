{
  "name": "saathi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:demo": "node tools/build-extension.mjs",
    "predev": "npm run sync:demo",
    "dev": "vite",
    "build": "npm run sync:demo && vite build",
